# PostHog project token (Project Settings). Leave blank to disable analytics.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# https://us.i.posthog.com or https://eu.i.posthog.com. Must be set at build time.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional. Uploads source maps during `next build` so production stack traces
# unminify. Personal API key needs error-tracking write access. The environment
# id is under PostHog Settings → Environment.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_ENV_ID=

# Neon Postgres connection string (pooled). Get it from https://console.neon.tech
DATABASE_URL=postgresql://reline:reline@localhost:5433/reline

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=changeme

# From Better Auth Infrastructure dashboard (https://www.better-auth.com/dashboard)
BETTER_AUTH_API_KEY=

# Public URL of the web app (auth cookies and Google redirects use this origin)
BETTER_AUTH_URL=http://localhost:4002

# Listen port (Render sets PORT automatically)
PORT=4001

# Google OAuth (optional). Authorized redirect URI:
# {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 — issue/comment attachments (images & videos).
# 1. Create a bucket in the Cloudflare dashboard (R2 → Create bucket).
# 2. Create an API token with "Object Read & Write" scoped to the bucket:
#    R2 → Manage R2 API Tokens. This gives you the access key id + secret.
# 3. Enable public access on the bucket (Settings → Public access →
#    R2.dev subdomain or a custom domain) and put that URL in R2_PUBLIC_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=reline
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Cursor MCP is served at {BETTER_AUTH_URL}/api/mcp (the web app proxies /api).
# Create a read-only token in Settings → Cursor. No extra env vars.

# PostHog ingest host for the browser proxy at /api/rline.
# EU Cloud: https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com

# Slack (optional). Create the app from apps/api/slack-app-manifest.json.
# Slack talks to the API, not the web app. Ticket links still use BETTER_AUTH_URL.
# Request URL: {API_PUBLIC_URL}/api/slack/events
# Redirects: {API_PUBLIC_URL}/api/slack/oauth/callback
#            {API_PUBLIC_URL}/api/slack/user/callback
# Generate the encryption key with: openssl rand -hex 32
API_PUBLIC_URL=http://localhost:4001
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_TOKEN_ENCRYPTION_KEY=
